{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    // Resolve suite packages to their SOURCES, exactly as vitest.config.ts
    // does. Without this, typecheck reads each package's built `dist` while
    // the tests read `src`, so the two disagree whenever dist is stale or
    // absent — and the disagreement shows up as a phantom "has no exported
    // member" for code that plainly exports it. The suite must also be
    // verifiable from a fresh clone, where no dist exists at all.
    "paths": {
      "@proworks-hub/forgeiq/demo/*": ["./packages/forgeiq/src/demo/*"],
      "@proworks-hub/forgeiq/manufacturing": ["./packages/forgeiq/src/manufacturing/buildManufacturingPlan.ts"],
      "@proworks-hub/forgeiq": ["./packages/forgeiq/src/core/index.ts"],
      "@proworks-hub/contracts": ["./packages/contracts/src/index.ts"],
      "@proworks-hub/senseiq": ["./packages/senseiq/src/index.ts"],
      "@proworks-hub/finance-core": ["./packages/finance-core/src/index.ts"],
      "@proworks-hub/core-kit": ["./packages/core-kit/src/index.ts"],
      "@proworks-hub/operations-core": ["./packages/operations-core/src/index.ts"],
      "@proworks-hub/resources-core": ["./packages/resources-core/src/index.ts"],
      "@proworks-hub/governance-engine": ["./packages/governance-engine/src/index.ts"],
      "@proworks-hub/intelligence-core": ["./packages/intelligence-core/src/index.ts"],
      "@proworks-hub/model-runtime": ["./packages/model-runtime/src/index.ts"],
      "@proworks-hub/model-evals": ["./packages/model-evals/src/index.ts"],
      "@proworks-hub/costiq": ["./packages/costiq/src/index.ts"],
      "@proworks-hub/prime": ["./packages/prime/src/index.ts"],
      "@proworks-hub/workorderiq": ["./packages/workorderiq/src/index.ts"],
      "@proworks-hub/receiptiq": ["./packages/receiptiq/src/index.ts"],
      "@proworks-hub/tracking": ["./packages/tracking/src/index.ts"],
      "@proworks-hub/inventoryiq": ["./packages/inventoryiq/src/index.ts"],
      "@proworks-hub/notifications": ["./packages/notifications/src/index.ts"],
      "@proworks-hub/order-ingestion": ["./packages/order-ingestion/src/index.ts"],
      "@proworks-hub/visioniq": ["./packages/visioniq/src/index.ts"],
      "@proworks-hub/platform-events": ["./packages/platform-events/src/index.ts"],
      "@proworks-hub/platform-runtime": ["./packages/platform-runtime/src/index.ts"],
      "@proworks-hub/control-plane/manifests": ["./packages/control-plane/src/manifests/index.ts"],
      "@proworks-hub/control-plane": ["./packages/control-plane/src/core/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*", "packages/*/tests/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
