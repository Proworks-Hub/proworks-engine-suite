{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/**/__tests__/**",
    "dist"
  ],
  "references": [
    {
      "path": "../auditiq"
    },
    {
      "path": "../repair-learning"
    },
    {
      "path": "../contracts"
    },
    {
      "path": "../core-kit"
    }
  ]
}
