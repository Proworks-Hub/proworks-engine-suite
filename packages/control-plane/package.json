{
  "name": "@proworks-hub/control-plane",
  "version": "0.13.0",
  "type": "module",
  "description": "Control plane \u2014 engine manifests, operational state, internal console authorization, and the telemetry-to-visualization adapter. Observes the engines; never runs them.",
  "author": "Steven Kreutzer",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Proworks-Hub/proworks-engine-suite.git",
    "directory": "packages/control-plane"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./manifests": {
      "types": "./dist/manifests/index.d.ts",
      "default": "./dist/manifests/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "dependencies": {
    "@proworks-hub/contracts": "*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.10.2"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepare": "tsc -b"
  }
}
