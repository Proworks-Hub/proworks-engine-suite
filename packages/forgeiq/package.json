{
  "name": "@proworks-hub/forgeiq",
  "version": "0.11.0",
  "type": "module",
  "description": "ForgeIQ — configure it, validate it, manufacture it. Produces the ManufacturingPlan.",
  "author": "Steven Kreutzer",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Proworks-Hub/proworks-engine-suite.git",
    "directory": "packages/forgeiq"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./manufacturing": {
      "types": "./dist/manufacturing/buildManufacturingPlan.d.ts",
      "default": "./dist/manufacturing/buildManufacturingPlan.js"
    },
    "./demo/firepit": {
      "types": "./dist/demo/firepit.d.ts",
      "default": "./dist/demo/firepit.js"
    },
    "./demo/metalSign": {
      "types": "./dist/demo/metalSign.d.ts",
      "default": "./dist/demo/metalSign.js"
    }
  },
  "dependencies": {
    "@proworks-hub/contracts": "*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.10.2"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "drizzle-orm": "^0.39.0",
    "express": "^5.0.0",
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepare": "tsc -b"
  }
}
