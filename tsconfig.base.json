{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@proworks-hub/contracts": ["./packages/contracts/src/index.ts"],
      "@proworks-hub/forgeiq": ["./packages/forgeiq/src/core/index.ts"],
      "@proworks-hub/forgeiq/*": ["./packages/forgeiq/src/*"],
      "@proworks-hub/costiq": ["./packages/costiq/src/index.ts"],
      "@proworks-hub/prime": ["./packages/prime/src/index.ts"]
    }
  }
}
