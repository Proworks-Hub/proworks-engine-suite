{
  "name": "proworks-engine-suite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ForgeIQ, CostIQ, and Prime \u2014 portable manufacturing intelligence engines. Hosts consume them; they depend on no host.",
  "workspaces": [
    "packages/contracts",
    "packages/forgeiq",
    "packages/costiq",
    "packages/prime"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -b packages/contracts packages/forgeiq packages/costiq packages/prime",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test",
    "clean": "tsc -b --clean packages/contracts packages/forgeiq packages/costiq packages/prime"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.102.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.31",
    "drizzle-orm": "^0.39.3",
    "express": "^5.2.1",
    "react": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^3.0.5",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  }
}
